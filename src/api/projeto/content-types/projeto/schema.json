{
  "kind": "collectionType",
  "collectionName": "projetos",
  "info": {
    "singularName": "projeto",
    "pluralName": "projetos",
    "displayName": "Projeto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "descricao": {
      "type": "blocks"
    },
    "escola": {
      "type": "string",
      "maxLength": 255
    },
    "area": {
      "type": "string",
      "maxLength": 255
    },
    "participantes": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
