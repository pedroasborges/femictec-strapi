{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Noticia"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "miniDescricao": {
      "type": "string",
      "maxLength": 255
    },
    "imagem": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "dataPublicacao": {
      "type": "datetime",
      "description": "Data inicial da noticia. E definida no primeiro salvamento e nao deve ser alterada depois."
    },
    "dataUltimaEdicao": {
      "type": "datetime",
      "description": "Atualizada automaticamente em cada edicao da noticia."
    },
    "descricaoImagem": {
      "type": "string"
    }
  }
}
