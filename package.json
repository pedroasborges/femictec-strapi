{
  "name": "femictec-strapi",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "node ./node_modules/@strapi/strapi/bin/strapi.js build",
    "console": "node ./node_modules/@strapi/strapi/bin/strapi.js console",
    "deploy": "node ./node_modules/@strapi/strapi/bin/strapi.js deploy",
    "dev": "node ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "develop": "node ./node_modules/@strapi/strapi/bin/strapi.js develop",
    "ops:pull": "node scripts/pull-update.mjs",
    "ops:push": "node scripts/push-git.mjs",
    "ops:deploy": "node scripts/deploy-cloud.mjs",
    "ops:push-deploy": "node scripts/push-and-deploy.mjs",
    "ops:sync-external-projects": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-external-projects.ps1",
    "start": "node ./node_modules/@strapi/strapi/bin/strapi.js start",
    "strapi": "node ./node_modules/@strapi/strapi/bin/strapi.js",
    "test:scripts": "node scripts/tests/run-tests.mjs",
    "test:integration:current-event": "node scripts/tests/current-event.integration.mjs",
    "test:integration:stats": "node scripts/tests/stats.integration.mjs",
    "test:integration:projects": "node scripts/tests/projects.integration.mjs",
    "test:integration:project-detail": "node scripts/tests/project-detail.integration.mjs",
    "test:integration:results": "node scripts/tests/results.integration.mjs",
    "test:integration:schedule": "node scripts/tests/schedule.integration.mjs",
    "test:integration:external-projects": "node scripts/tests/external-projects.integration.mjs",
    "test:all": "npm run test:scripts && npm run test:integration:current-event && npm run test:integration:stats && npm run test:integration:projects && npm run test:integration:project-detail && npm run test:integration:results && npm run test:integration:schedule",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
    
  },
  "dependencies": {
    "@strapi/plugin-cloud": "5.43.0",
    "@strapi/plugin-users-permissions": "5.43.0",
    "@strapi/provider-email-nodemailer": "^5.48.1",
    "@strapi/strapi": "5.43.0",
    "better-sqlite3": "12.6.2",
    "pg": "^8.21.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
